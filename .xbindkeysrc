# take screenshot
"scrot ~/Pictures/Screenshots/Screenshot-%y.%m.%-d_%H.%S.png -e 'xclip -selection clipboard -t image/png < $f && notify-send \"Screenshot Saved.\" \"$f\"'"
    Print

# make copy selection
"scrot -s -q 100 -e 'xclip -selection clipboard -t image/png < $f; notify-send \"Selection Copied To Clipboard.\"'"
    Control + Print

# raise volume
"wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+ && pkill -USR1 slstatus"
    XF86AudioRaiseVolume

# lower volume
"wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- && pkill -USR1 slstatus"
    XF86AudioLowerVolume

# raise brightness
"sh -c 'brightnessctl set +10%; val=$(brightnessctl -m | cut -d, -f4); notify-send -r 9999 Display\ Brightness:\ $val'"
    XF86MonBrightnessUp

# lower brightness
"sh -c 'brightnessctl set 10%-; val=$(brightnessctl -m | cut -d, -f4); notify-send -r 9999 Display\ Brightness:\ $val'"
    XF86MonBrightnessDown
